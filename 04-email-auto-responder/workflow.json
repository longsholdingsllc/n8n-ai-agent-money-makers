        "options": {
          "systemMessage": "You are a professional email assistant. Draft a clear, polite, and actionable reply. Keep it under 150 words unless complexity requires more. Output only the email body text."
        }
      },
      "id": "ai-draft",
      "name": "AI Draft Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [520, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o-mini",
        "options": {}
      },
      "id": "model",
      "name": "OpenAI Chat Model",
      "type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
      "typeVersion": 1,
      "position": [520, 500]
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [[{ "node": "AI Draft Agent", "type": "main", "index": 0 }]]
    },
    "OpenAI Chat Model": {
      "ai_languageModel": [[{ "node": "AI Draft Agent", "type": "ai_languageModel", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
